# ── Frontend (Next.js) ───────────────────────────────────────────────────
# Server-side base URL for every fetch. Must include the /api suffix.
# Used by lib/api/core.ts → publicFetch (public, cached pages) and by
# the dashboard service layer.
API_URL=http://localhost:5000/api

# Same value. Inlined at build time, so it must be visible to the browser
# bundle — used by components/LiveRefresh.tsx (SSE) and dashboard services.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Shared secret. The backend sends this as `x-revalidate-secret` when it POSTs
# to /api/revalidate after a write. Must match REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=dev_revalidate_secret_change_me

# ── SEO ──────────────────────────────────────────────────────────────────
# Public origin of THIS frontend (no trailing slash, no /api suffix). Used as
# the base for canonical URLs, Open Graph URLs, sitemap.xml and robots.txt.
#
# Precedence in lib/seo/metadata.ts: the dashboard-managed `siteUrl` from Site
# Settings (GET /api/settings → seo.siteUrl) wins; these env vars are the
# fallback when the backend has none configured.
#
# Local dev: http://localhost:3000
# Production: set to the real https origin, e.g. https://example.com
#   (validated to be an absolute http/https URL; an invalid value is ignored)
#
# NEXT_PUBLIC_SITE_URL is inlined for the browser bundle. If no client code
# needs the origin, SITE_URL alone is sufficient.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
